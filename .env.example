# Ejemplo de configuración. NO hace falta copiarlo ni editarlo: la app tiene un
# formulario (Configuración) que genera el archivo .env real. Está acá sólo para
# que se vea qué guarda. El .env real nunca se sube al repo (.gitignore).

# Gmail donde llegan los avisos del PJN (scw-noreply@pjn.gov.ar)
GMAIL_USUARIO='nombre@gmail.com'
# Contraseña de aplicación de Google (16 letras), NO la clave de Gmail.
# Se crea en https://myaccount.google.com/apppasswords
GMAIL_CLAVE_APP=''
# Usuario del PJN (CUIT/CUIL). La clave del PJN NO se guarda: la app la pide al abrir.
PJN_USUARIO=''
# Carpeta del Excel, la base y los PDFs (relativa a la app o absoluta)
CARPETA_DATOS='datos'
# Días hacia atrás para leer mails
DIAS_ATRAS='7'
# Sólo causas cuya carátula contenga alguna de estas palabras (vacío = todas)
FILTRO_CARATULA=''
# 1 = descargar el PDF de cada actuación nueva
DESCARGAR_PDFS='1'
